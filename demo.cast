[8.770506620407104,"o","\u001b[?25l\u001b[8;1H***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n<command> info <имя_таблицы> - вывести информацию о таблице\u001b[15;1H***Операции с данными***\r\nФункции:\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись.\r\n<command> select from <имя_таблицы> where <столбец> = <значение> - прочитать записи.\r\n<command> select from <имя_таблицы> - прочитать все записи.\r\n<command> update <имя_таблицы> set <столбец1> = <значение1> where <столбец_условия> = <значение_условия>\r\n<command> delete from <имя_"]
[8.770596027374268,"o","таблицы> where <столбец> = <значение> - удалить запись.\u001b[27;1HОбщие команды:\r\n<command> exit - выход из программы\r\n<command> help - справочная информация\u001b[31;1H>>>Введите команду: \u001b[?25h"]
